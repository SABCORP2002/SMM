# ─── Base de données ────────────────────────────────────────────────
# Dev : SQLite local (aucune installation). Prod : URL PostgreSQL.
DATABASE_URL="file:./dev.db"

# ─── Application ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="JAL SMM"
# Secret de signature des sessions (généré : openssl rand -base64 32)
SESSION_SECRET=""

# ─── Contact / support (affiché sur le site) ───────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="+2250000000000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@jalsmm.com"

# ─── Fournisseur SMM par défaut (mode bac à sable pour l'instant) ──
# Renseigné par le client au moment venu. Voir prisma/seed.ts.
SMM_PROVIDER_API_URL=""
SMM_PROVIDER_API_KEY=""

# ─── Passerelles de paiement (identifiants fournis par le client) ──
# FedaPay (Bénin, Côte d'Ivoire, Togo, Sénégal...)
FEDAPAY_SECRET_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_ENVIRONMENT="sandbox"

# CinetPay (zone UEMOA + Cameroun, RDC, Guinée...)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_ENVIRONMENT="TEST"

# PayDunya (Sénégal, Côte d'Ivoire, Bénin, Burkina, Mali, Togo)
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_MODE="test"

# Paystack (Nigeria, Ghana + international par carte)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
